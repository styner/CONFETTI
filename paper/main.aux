\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces CONFETTI overview. (a) Per-subject parametrized fiber bundles ($66$ tracts, $5$ DTI/NODDI metrics); (b) per-tract parametrized fiber axes at $L_0$, computed as a median across each bundle's fibers; (c) SIREN per-subject INR imputation of missing diffusion profiles; (d) hierarchical multi-resolution neighborhood graph ($L_2$, $L_4$, $L_5$ shown), built once over the template axes; (e) three GCN heads sharing the CONFETTI front-end and out-of-fold attribution back-end.}}{3}{}\protected@file@percent }
